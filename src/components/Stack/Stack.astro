---
import type { TechIconKey } from "@components/Icon.astro";
import { techIcon } from "@components/Icon.astro";
import Image from "astro/components/Image.astro";

export interface TechnologyListProps {
  techs: TechIconKey[];
  usedTechs: Set<string>;
}
const { techs, usedTechs } = Astro.props as TechnologyListProps;
---

<ul
  class="grid flex-1 grid-cols-[repeat(auto-fill,minmax(5.5rem,1fr))] content-start gap-1 rounded-2xl border border-line bg-white p-2"
>
  {
    techs.map((tech) => (
      <li>
        <button
          type="button"
          data-tech-filter={tech}
          data-tech-name={techIcon[tech].name}
          aria-pressed="false"
          disabled={!usedTechs.has(tech)}
          class="flex w-full flex-col items-center gap-2 rounded-xl px-1 py-3 text-xs transition-[background-color,color,transform] focus-visible:outline-2 focus-visible:outline-pinkish enabled:cursor-pointer enabled:hover:bg-chip enabled:active:scale-95 aria-pressed:bg-pinkish/10 aria-pressed:text-pinkish-dark motion-reduce:transition-none"
        >
          <Image
            draggable="false"
            src={techIcon[tech].icon}
            alt=""
            class="h-8 w-8 object-contain"
          />
          {techIcon[tech].name}
        </button>
      </li>
    ))
  }
</ul>
