---
import type { TechIconKey } from "@components/Icon.astro";
import { techIcon } from "@components/Icon.astro";
import Image from "astro/components/Image.astro";

// import Swiper styles
export interface TechnologyListProps {
  title: string;
  techs: TechIconKey[];
}
const { title, techs } = Astro.props as TechnologyListProps;
---

<div
  class="flex justify-center items-center flex-col align-bottom max-w-5xl w-full"
>
  <h4 class="text-3xl font-medium" aria-label={title} aria-labelledby={title}>
    {title}
  </h4>
  <ul
    class="inline-flex flex-wrap gap-6 flex-row justify-center m-2 items-end border border-[#fe5980] rounded-2xl w-fit backdrop-blur-[0.6px]"
  >
    {
      techs.map((tech) => (
        <li class="flex justify-end flex-col items-center gap-2 pb-1  rounded-md w-20 h-20 ">
          <Image
            draggable="false"
            src={techIcon[tech].icon}
            alt={tech}
            class="w-10"
          />
          <p class="text-xs">{techIcon[tech].name}</p>
        </li>
      ))
    }
  </ul>
</div>
