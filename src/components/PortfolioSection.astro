---
import project from "../data/project.json";

import elSemillero from "../assets/elsemillero.png";
import kataproj from "../assets/katapic.png";
import laEdicola from "../assets/laedico.png";
import PortfolioStack from "./PortfolioStack/PortfolioStack.astro";

/* #22d3ee */

const { kataplunchis, laedicola, elsemillero } = project;
---

<div class="py-10 w-full">
  <div class="flex justify-center flex-col items-center gap-2">
    <h2
      class="text-5xl font-bold backdrop-blur-[0.8px]"
      aria-label="portfolio"
      id="portfolio"
    >
      Portfolio
    </h2>
  </div>
  <div class="flex flex-col items-center justify-between m-3 gap-3">
    <PortfolioStack
      title={"La Edícola"}
      concept={"Ebook storefront for comic publishers (Beta)"}
      description={"Mobile and web storefront for 20 local comic publishing houses, with an ebook reader, code redemption and Mercado Pago payments. Launching in 2027."}
      tech={laedicola.frontend}
      image={laEdicola}
    />
    <PortfolioStack
      title={"El Semillero Club"}
      concept={"Free reading of Argentine graphic novels"}
      description={"Online library where readers discover and read Argentine graphic novels for free. Live with active readers."}
      tech={elsemillero.frontend}
      image={elSemillero}
    />
    <PortfolioStack
      title={"Kataplunchis"}
      concept={"Comic artist page (in progress)"}
      description={"Portfolio site for a comic artist, showcasing their art and stories."}
      tech={kataplunchis.frontend}
      image={kataproj}
    />
  </div>
</div>
