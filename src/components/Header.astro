---
import Image from "astro/components/Image.astro";
import profile from "../../public/images/profile.png";
---

<header
  id="profile"
  class="flex scroll-mt-20 flex-col-reverse items-start gap-10 pt-6 md:flex-row md:items-center md:justify-between"
>
  <h1 class="fade-in-up flex flex-col gap-2">
    <span class="text-lg text-muted">Hello, I'm</span>
    <span
      class="text-4xl font-extrabold tracking-tight text-pinkish sm:text-5xl md:text-6xl"
      >Rodrigo Atencio</span
    >
    <span class="text-2xl font-extrabold md:text-3xl"
      >Senior mobile & full stack engineer</span
    >
  </h1>
  <div class="fade-in-up mr-8 mb-8">
    <Image
      src={profile}
      alt="Rodrigo Atencio"
      loading="eager"
      draggable="false"
      class="profile-pic w-48 md:w-60"
    />
  </div>

  <style>
    .profile-pic {
      border-radius: 50%;
      box-shadow: 32px 32px 0 #fe5980;
      transition:
        box-shadow 0.3s ease,
        transform 0.3s ease;
    }
    .profile-pic:hover {
      box-shadow: 20px 20px 0 #fe5980;
      transform: translate(6px, 6px);
    }
    @media (prefers-reduced-motion: reduce) {
      .profile-pic {
        transition: none;
      }
    }
  </style>
</header>
