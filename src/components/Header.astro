---
import Image from "astro/components/Image.astro";
import profile from "../../public/images/profile.png";

import gitIconGreen from "../assets/icons/github-green.svg";
import linkedin from "../assets/icons/linkedin.svg";
---

<main>
  <div class="gap-3 flex">
    <Image src={gitIconGreen} alt="" class="w-6" />
    <Image src={linkedin} alt="" class="w-6" />
  </div>
  <div class="flex"><p>git</p><p>linkedin</p></div>
  <header class="flex">
    <div
      class="flex justify-between align-middle flex-col-reverse md:flex-row md:gap-0"
    >
      <div class="flex gap-36 self-center flex-col items-center">
        <h1
          class="md:max-w-[630px] text-center w-full text-sm md:text-6xl sm:mt-5 leading-10"
        >
          <span class="subtitle"> Hello, I'm </span><span
            class="text-pinkish subtitle">Rodrigo Atencio</span
          >,
          <span>a</span>
          <span class="role"> full.stack developer</span>
        </h1>
      </div>
      <div class="flex justify-center items-center mb-20 md:mb-0">
        <Image
          src={profile}
          alt="Profile pic"
          loading="eager"
          class="profile-pic w-60 h-auto"
        />
      </div>
    </div>
    <!--   <div class="absolute left-0 top-0 w-full h-full opacity-100 -z-50">
      <img src="/src/assets/side-laptop.png" alt="" class="" /> laptop
    </div> -->
  </header>
</main>

<style>
  h1 {
    font-size: 50px;
    margin: 0;
  }
  .subtitle {
    font-weight: 200;
  }
  .thin {
    opacity: 0.7;
  }
  .name {
    font-weight: 400;
  }

  .role {
    font-weight: 700;
  }

  .profile-pic {
    border-radius: 50%;
    margin-top: 1rem;
    box-shadow: 50px 50px 0px #fe5980;
  }
</style>
