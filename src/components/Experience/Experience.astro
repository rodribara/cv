---
import ExperienceDetails from "./ExperienceDetails.astro";
import RoleStack from "./RoleStack.astro";

export interface ExperienceProps {
  image: string;
  name: string;
  organization: string;
  period: string;
  project: string;
  mainRole: string;
  roleStack: {
    frontend: string[];
    backend: string[];
    management: string[];
  };
  description: string;
}

const {
  experience: { roleStack, ...experience },
} = Astro.props as { experience: ExperienceProps };

const techs = [
  ...roleStack.frontend,
  ...roleStack.backend,
  ...roleStack.management,
];
---

<!-- the fade wraps the card because its animation would pin the card's opacity -->
<div class="fade-in-up">
  <article
    data-techs={techs.join(" ")}
    data-kind="role"
    class="flex flex-col gap-8 rounded-2xl border border-line bg-white p-6 transition-[opacity,filter,border-color] duration-300 hover:border-pinkish/40 data-dimmed:opacity-40 data-dimmed:grayscale md:flex-row"
  >
    <ExperienceDetails experience={experience} />
    <RoleStack roleStack={roleStack} />
  </article>
</div>
