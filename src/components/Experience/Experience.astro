---
import ExperienceDetails from "./ExperienceDetails.astro";
import RoleStack from "./RoleStack.astro";

export interface ExperienceProps {
  image: string;
  name: string;
  organization: string;
  mainRole: string;
  roleStack: {
    frontend: string[];
    backend: string[];
    management: string[];
  };
  experienceType: string;
  description: string;
}

const {
  experience: { roleStack, ...experience },
} = Astro.props as { experience: ExperienceProps };
---

<div class="flex flex-col items-center fade-in-up">
  <div
    class="flex items-start flex-col md:flex-row border border-[#14b8a6] mx-3 rounded-2xl w-fit backdrop-blur-[0.6px]"
  >
    <ExperienceDetails experience={experience} />
    <RoleStack roleStack={roleStack} />
  </div>
</div>
