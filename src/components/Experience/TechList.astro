---
import type { TechIconKey } from "@components/Icon.astro";
import { techIcon } from "@components/Icon.astro";
import Image from "astro/components/Image.astro";
export interface TechnologyListProps {
  title: string;
  techs: TechIconKey[];
}

const { title, techs } = Astro.props as TechnologyListProps;
---

<div
  class="flex md:justify-center sm:justify-start items-center flex-col mx-7 gap-3"
>
  <h4 class="text-xl font-medium" aria-label={title} aria-labelledby={title}>
    {title}
  </h4>
  <ul class="inline-flex flex-wrap gap-2 flex-row justify-center">
    {
      techs.map(
        (
          tech //removed index for li keys
        ) => (
          <li class="flex justify-start flex-row gap-2 border border-[#fe5980] rounded-2xl px-2 py-1 bg-[#fe5980]/5 backdrop-blur-[20px]">
            <Image
              draggable="false"
              src={techIcon[tech].icon}
              alt={tech}
              class="w-4 self-center"
            />
            <p class="text-xs]">{tech}</p>
          </li>
        )
      )
    }
  </ul>
</div>
