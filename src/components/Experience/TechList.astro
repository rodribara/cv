---
import type { TechIconKey } from "@components/Icon.astro";
import { techIcon } from "@components/Icon.astro";
import Image from "astro/components/Image.astro";
export interface TechnologyListProps {
  title: string;
  techs: TechIconKey[];
}

const { title, techs } = Astro.props as TechnologyListProps;
---

<div class="flex flex-col gap-2">
  {title && <h4 class="text-sm font-extrabold text-muted">{title}</h4>}
  <ul class="flex flex-wrap gap-1.5">
    {
      techs.map((tech) => (
        <li
          data-tech={tech}
          class="flex items-center gap-1.5 rounded-full border border-line bg-chip px-2.5 py-1 text-xs transition-colors data-match:border-pinkish data-match:bg-pinkish/10 data-match:text-pinkish-dark"
        >
          <Image
            draggable="false"
            src={techIcon[tech].icon}
            alt=""
            class="h-3.5 w-3.5 object-contain"
          />
          {techIcon[tech].name}
        </li>
      ))
    }
  </ul>
</div>
