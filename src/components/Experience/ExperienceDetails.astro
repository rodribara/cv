---
import type { CompanyLogoKey } from "@components/Logo.astro";
import { companyLogo } from "@components/Logo.astro";
import Image from "astro/components/Image.astro";
export interface ExperienceDetailsProps {
  experience: {
    logo: CompanyLogoKey;
    name: string;
    organization: string;
    period: string;
    project: string;
    mainRole: string;
    description: string;
  };
}

const {
  experience: { logo, name, organization, period, project, description },
} = Astro.props as ExperienceDetailsProps;
---

<div class="flex flex-col gap-4 md:w-1/2">
  <Image
    loading="lazy"
    src={companyLogo[logo]}
    alt={organization}
    height={64}
    draggable="false"
    class="h-8 w-auto self-start object-contain"
  />
  <div class="flex flex-col gap-1">
    <p class="text-xs font-extrabold text-muted">{period}</p>
    <h3 class="text-xl font-extrabold">{name}</h3>
    <p class="text-muted">{organization} · {project}</p>
  </div>
  <ul class="flex list-disc flex-col gap-1.5 pl-5 text-[15px] leading-relaxed">
    {description.split("\n").map((line) => <li>{line}</li>)}
  </ul>
</div>
