---
import TechList from "@components/Experience/TechList.astro";
import Image from "astro/components/Image.astro";

const { tech, image, title, concept, description } = Astro.props;
---

<div
  class="flex flex-col md:flex-row items-center justify-between rounded-2xl border border-[#22d3ee] p-3 w-full backdrop-blur-[0.6px] gap-3"
>
  <div class="flex flex-col items-center">
    <h3
      class="text-3xl font-bold items-center justify-center w-fit backdrop-blur-[0.8px] p-2 rounded-md"
      aria-label="frontend"
    >
      {title}
    </h3>
    <p>{concept}</p>
    <p>{description}</p>
    <TechList title="" techs={tech} />
  </div>
  <div>
    <Image
      src={image}
      alt="Kataplunchis"
      class="rounded-2xl border border-gray-200"
      width={500}
      height={500}
    />
  </div>
</div>
