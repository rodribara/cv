---
import TechList from "@components/Experience/TechList.astro";
import Image from "astro/components/Image.astro";

const { tech, image, title, concept, description } = Astro.props;
---

<article
  data-techs={tech.join(" ")}
  data-kind="project"
  class="flex flex-col gap-6 rounded-2xl border border-line bg-white p-6 transition-[opacity,filter,border-color] duration-300 hover:border-pinkish/40 data-dimmed:opacity-40 data-dimmed:grayscale md:flex-row md:items-center"
>
  <div class="flex flex-col gap-3 md:w-1/2">
    <div class="flex flex-col gap-1">
      <h3 class="text-xl font-extrabold">{title}</h3>
      <p class="text-muted">{concept}</p>
    </div>
    <p class="leading-relaxed">{description}</p>
    <TechList title="" techs={tech} />
  </div>
  <Image
    src={image}
    alt={title}
    class="rounded-xl border border-line md:w-1/2"
    width={500}
    height={500}
  />
</article>
