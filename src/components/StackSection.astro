---
import stack from "../data/stack.json";
import Stack from "./Stack/Stack.astro";
---

<main class="py-10">
  <div class="flex justify-center flex-col items-center gap-2">
    <h2
      class="text-5xl font-bold backdrop-blur-[0.8px]"
      aria-label="stack"
      id="stack"
    >
      Stack
    </h2>
  </div>
  <div class="flex flex-col items-center justify-between m-1">
    <div class="flex flex-col md:flex-row items-start justify-between">
      <div class="flex justify-center flex-col items-center fade-in-up">
        <h3
          class="text-3xl font-bold items-center justify-center w-fit backdrop-blur-[0.8px] p-2 rounded-md"
          aria-label="frontend"
        >
          Frontend
        </h3>
        <Stack techs={stack.mainStack.frontend} />
      </div>
      <div class="flex justify-center flex-col items-center fade-in-up">
        <h3
          class="text-3xl font-bold items-center justify-center w-fit backdrop-blur-[0.8px] p-2 rounded-md"
          aria-label="backend"
        >
          Backend
        </h3>
        <Stack techs={stack.mainStack.backend} />
      </div>

      <div class="flex justify-center flex-col items-center fade-in-up">
        <h3
          class="text-3xl font-bold items-center justify-center w-fit backdrop-blur-[0.8px] p-2 rounded-md"
          aria-label="management"
        >
          Management
        </h3>
        <Stack techs={stack.mainStack.management} />
      </div>
    </div>
    <div class="flex justify-center flex-col items-center fade-in-up gap-2">
      <h3
        class="text-3xl font-bold w-fit backdrop-blur-[0.8px] p-2 rounded-md"
        aria-label="complementary stack"
      >
        Complementary Stack
      </h3>
    </div>
    <div class="flex flex-col items-center justify-center gap-9">
      <div class="flex flex-col items-start justify-start gap-9">
        <div class="flex flex-col items-center">
          <Stack techs={stack.secondaryStack} />
        </div>
      </div>
    </div>
  </div>
</main>
