---
export interface NavProps {
  name: string;
  image: string;
  variant: "pink" | "green" | "black";
}

const { name, variant } = Astro.props as NavProps;

const variantClasses = {
  pink: { bg: "bg-[#FE5980]", text: "text-onyx" },
  black: { bg: "bg-onyx", text: "text-white" },
  green: { bg: "bg-[#14B8A6]", text: "text-onyx" },
}[variant] || { bg: "bg-[#FE5980]", text: "text-onyx" };
---

<div
  class={`rounded-md ${variantClasses.bg} hover:${variantClasses.bg}/50 p-2 w-full h-full items-end flex `}
>
  <div><p class={`text-[20px] rounded-full ${variantClasses.text}`}>01</p></div>
  <p class={`text-2xl italic font-semibold ${variantClasses.text}`}>{name}</p>
</div>
