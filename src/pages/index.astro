---
import Container from "@components/Container.astro";
import CoverLetter from "@components/CoverLetter.astro";
import PortfolioSection from "@components/PortfolioSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import Header from "../components/Header.astro";
import HireHimAlready from "../components/HireHimAlready.astro";
import StackSection from "../components/StackSection.astro";
import Layout from "../layouts/Layout.astro";
import "../style/global.css";
---

<Layout>
  <Container
    ><!-- 
    <img src="/src/assets/title.png" /> -->
    <Header />
    <CoverLetter />
    <StackSection />
    <ExperienceSection />
    <PortfolioSection />
    <HireHimAlready title="Get a Quote" />
    <div
      class="fixed inset-0 -z-10 h-full w-full bg-[linear-gradient(to_right,#fe598030_1px,transparent_1px),linear-gradient(to_bottom,#fe598030_1px,transparent_1px)] bg-[size:14px_24px]"
    >
    </div>
  </Container>
</Layout>
