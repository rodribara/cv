---
import Container from "@components/Container";
import CoverLetter from "@components/CoverLetter.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import Header from "../components/Header.astro";
import HireHimAlready from "../components/HireHimAlready.astro";
import StackSection from "../components/StackSection.astro";
import Layout from "../layouts/Layout.astro";
import "../style/global.css";
---

<Layout>
  <div class="absolute left-0 top-0 w-full h-full z-10 opacity-100">
    <img src="/src/assets/side-laptop.png" alt="" />
  </div>
  <Container>
    <img src="/src/assets/title.png" />
    <Header />
    <CoverLetter />
    <HireHimAlready title="Hire Now" />
    <StackSection />

    <ExperienceSection />
    <HireHimAlready title="Get a Quote" />
  </Container>
</Layout>
