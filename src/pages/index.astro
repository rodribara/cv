---
import Container from "@components/Container.astro";
import CoverLetter from "@components/CoverLetter.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import Header from "../components/Header.astro";
import HireHimAlready from "../components/HireHimAlready.astro";
import StackSection from "../components/StackSection.astro";
import Layout from "../layouts/Layout.astro";
import "../style/global.css";
---

<Layout>
  
  <div class="sticky-wrapper">
    <div class="sticky-bg">
      <img src="/src/assets/side-laptop.png" id="laptop" alt="laptop" />
    </div>
    <Container
      ><!-- 
    <img src="/src/assets/title.png" /> -->

      <Header />
  </Container>
  
  
  
  <Container>
      <CoverLetter />
      <HireHimAlready title="Hire Now" />
      <div class="sticky-wrapper">
        <div class="sticky-bg">
          <img src="/src/assets/chair.png" id="chair" alt="laptop" />
        </div>
        <StackSection />

        <ExperienceSection />
        <div class="sticky-wrapper-experience">
          <div class="sticky-bg">
            <img src="/src/assets/coffee.png" id="chair" alt="laptop" />
          </div>
          <HireHimAlready title="Get a Quote" />
        </div>
      </div>
    </Container>
    <style>
      .sticky-wrapper {
        height: 700px;
        position: relative;

        width: 100%;
      }
      .sticky-wrapper-experience {
        height: 1800px;
        position: relative;

        width: 100%;
      }

      .sticky-bg {
        position: sticky;
        top: 0;
        z-index: -50;
        height: 0;
        pointer-events: none;
        overflow: visible;
      }

      .sticky-bg img {
        position: absolute;
        top: 0;
        display: block;
        width: 700px;
        height: auto;
      }
      #laptop {
        left: 0;
      }
      #chair {
        right: 0;
      }

      #laptop2 {
        right: 0;
      }
    </style>
  </div>
</Layout>
